<UserControl x:Class="CaptureFlow.Desktop.Views.OverlayControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Camera overlay" Style="{StaticResource Heading}" Margin="0,0,0,12"/>
        <CheckBox Content="Show webcam overlay" IsChecked="{Binding OverlayVisible}" Margin="0,0,0,12" ToolTip="Show or hide the webcam in preview and export without stopping capture."/>
        <TextBlock Text="Position presets" Style="{StaticResource Label}"/>
        <WrapPanel><Button Content="Top-left" Command="{Binding PositionOverlayCommand}" CommandParameter="TopLeft" Margin="0,0,8,8"/><Button Content="Top-right" Command="{Binding PositionOverlayCommand}" CommandParameter="TopRight" Margin="0,0,8,8"/><Button Content="Bottom-left" Command="{Binding PositionOverlayCommand}" CommandParameter="BottomLeft" Margin="0,0,8,8"/><Button Content="Bottom-right" Command="{Binding PositionOverlayCommand}" CommandParameter="BottomRight" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock Text="Shape" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding OverlayShapeOptions}" SelectedItem="{Binding SelectedOverlayShape}" AutomationProperties.Name="Webcam overlay shape"/>
        <TextBlock Text="Overlay width (% of screen)" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider Style="{StaticResource VolumeSlider}" Minimum="5" Maximum="100" Value="{Binding OverlayWidthPercent}" AutomationProperties.Name="Webcam overlay width"/><TextBlock Grid.Column="1" Text="{Binding OverlayWidthPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <CheckBox Content="Show border" IsChecked="{Binding OverlayBorderEnabled}" Margin="0,12,0,0"/>
        <TextBlock Text="Border thickness (capture pixels)" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="16" Value="{Binding OverlayBorderThickness}" IsEnabled="{Binding OverlayBorderEnabled}" AutomationProperties.Name="Camera border thickness"/><TextBlock Grid.Column="1" Text="{Binding OverlayBorderThickness, StringFormat={}{0:0} px}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <TextBlock Text="Drag the camera in the preview or use its corner handle to resize. Circle uses a centered square crop. Layout and visibility changes also apply during recording." Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
