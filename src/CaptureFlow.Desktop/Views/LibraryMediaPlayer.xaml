<UserControl x:Class="CaptureFlow.Desktop.Views.LibraryMediaPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PlayerRoot" Background="#0D1119">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="VideoSurface" Background="#090C13" CornerRadius="10" MinHeight="180">
            <Grid><MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="MediaOpened" MediaFailed="MediaFailed" MediaEnded="MediaEnded"/>
                <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="40" Foreground="#7775FF" HorizontalAlignment="Center"/><TextBlock x:Name="PlaceholderText" Text="Select a recording and choose Open" Foreground="#A8B2C6" Margin="0,12,0,0"/></StackPanel></Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="FileTitle" Text="Playback" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="SeekChanged" PreviewMouseLeftButtonDown="SeekBegin" PreviewMouseLeftButtonUp="SeekEnd" AutomationProperties.Name="Playback seek position" Margin="0,10,0,4"/>
            <DockPanel><TextBlock x:Name="CurrentTime" Text="00:00:00" Foreground="#A8B2C6"/><TextBlock x:Name="TotalTime" Text="00:00:00" Foreground="#A8B2C6" HorizontalAlignment="Right"/></DockPanel>
            <WrapPanel Margin="0,10,0,0"><Button x:Name="PlayButton" Content="Play" Click="PlayClicked" Margin="0,0,8,8"/><Button x:Name="PauseButton" Content="Pause" Click="PauseClicked" Margin="0,0,8,8"/><Button x:Name="StopButton" Content="Stop" Click="StopClicked" Margin="0,0,8,8"/><Button x:Name="MuteButton" Content="Mute" Click="MuteClicked" Margin="0,0,8,8"/><Slider x:Name="Volume" Minimum="0" Maximum="1" Value="0.7" Width="90" VerticalAlignment="Center" ValueChanged="VolumeChanged" AutomationProperties.Name="Playback volume" Margin="0,0,10,8"/><Button x:Name="FullscreenButton" Content="Fullscreen" Click="FullscreenClicked" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" TextWrapping="Wrap" Foreground="#A8B2C6" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
