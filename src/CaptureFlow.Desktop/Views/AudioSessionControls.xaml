<UserControl x:Class="CaptureFlow.Desktop.Views.AudioSessionControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
    <WrapPanel>
        <StackPanel Width="220" Margin="0,0,16,12"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#29CBDF" Margin="0,0,8,0"/><TextBlock Text="{Binding StatusLabel}" Foreground="#29CBDF"/></StackPanel><TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="42" Margin="0,10,0,0" AutomationProperties.Name="Actual recorded audio duration"/></StackPanel>
        <StackPanel Width="270"><Button Content="●  Start Recording" Command="{Binding StartCommand}" FontSize="16" MinHeight="48" Style="{StaticResource PrimaryButton}" ToolTip="Record the selected microphone and/or playback device using the selected output format."/><TextBlock Text="{Binding SelectedFormat, StringFormat=Selected audio sources · {0}}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,12"/><UniformGrid Columns="3"><Button Content="Pause" Command="{Binding PauseCommand}" Margin="0,0,6,0" Padding="10,6" ToolTip="Omit incoming audio until Resume; devices remain open."/><Button Content="Resume" Command="{Binding ResumeCommand}" Margin="0,0,6,0" Padding="10,6"/><Button Content="Stop" Command="{Binding StopCommand}" Padding="10,6" ToolTip="Stop capture, finalize WAV and export MP3 when selected."/></UniformGrid></StackPanel>
    </WrapPanel>
    <Button Content="Cancel export" Command="{Binding CancelExportCommand}" Visibility="{Binding IsExporting, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Cancel MP3 encoding and retain the intermediate WAV."/>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
</StackPanel>
</UserControl>

