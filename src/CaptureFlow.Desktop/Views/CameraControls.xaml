<UserControl x:Class="CaptureFlow.Desktop.Views.CameraControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CaptureFlow.Desktop.Views">
    <StackPanel>
        <DockPanel Visibility="{Binding ShowPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,14"><TextBlock DockPanel.Dock="Right" Text="{Binding CameraStateLabel}" Foreground="#B7B6FF" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="Live video preview" Style="{StaticResource Heading}" Margin="0"/></DockPanel>
        <Border Visibility="{Binding ShowPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}" Background="#0D1119" BorderBrush="#354057" BorderThickness="1" CornerRadius="10" Height="300" ClipToBounds="True" Margin="0,0,0,16">
            <Grid>
                <Image Source="{Binding CameraPreview}" Stretch="Uniform" AutomationProperties.Name="Live webcam preview" Visibility="{Binding IsWebcam, Converter={StaticResource BoolVisibility}}"/><views:CompositePreviewEditor Visibility="{Binding IsCombined, Converter={StaticResource BoolVisibility}}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="20" Visibility="{Binding HasNoPreview, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="#7775FF" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="Start preview to see your video sources" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Choose a camera and a reported format below. Recording uses this same live source." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel IsEnabled="{Binding CanChangeCamera}">
            <TextBlock Text="Camera" Style="{StaticResource Label}" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" DisplayMemberPath="Name" AutomationProperties.Name="Webcam device"/>
            <TextBlock Text="No camera detected. Connect or enable a built-in or USB webcam, then refresh devices." Style="{StaticResource MutedText}" Margin="0,10,0,0" Visibility="{Binding HasNoCameras, Converter={StaticResource BoolVisibility}}"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Camera resolution" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding CameraResolutions}" SelectedItem="{Binding SelectedCameraResolution}" AutomationProperties.Name="Supported camera resolution"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Camera frame rate" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding CameraFrameRates}" SelectedItem="{Binding SelectedCameraFormat}" DisplayMemberPath="FrameRateLabel" AutomationProperties.Name="Supported camera frame rate"/></StackPanel>
            </Grid>
        </StackPanel>
        <WrapPanel Margin="0,16,0,0"><Button Content="Start preview" Command="{Binding StartPreviewCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Stop preview" Command="{Binding StopPreviewCommand}" Margin="0,0,8,8"/><Button Content="Reload camera" Command="{Binding LoadCameraCommand}" Margin="0,0,8,8"/><Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" Margin="0,0,0,8"/></WrapPanel>
        <views:OverlayControls Visibility="{Binding IsCombined, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,12"/><TextBlock Text="{Binding CameraMessage}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
        <TextBlock Text="Webcam Only supports microphone audio. Screen + Webcam supports microphone, system audio, both, or no audio." Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>

