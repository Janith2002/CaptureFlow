<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaptureFlow.Desktop.Views.StudioRecordingControls">
  <Grid ToolTip="{Binding CaptureExclusionNotice}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse Width="7" Height="7" Fill="{StaticResource PurpleBrush}" Margin="0,0,10,0"/>
      <StackPanel>
        <TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="22" AutomationProperties.Name="Studio recording elapsed time"/>
        <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{StaticResource Muted}" ToolTip="{Binding StatusMessage}"/>
      </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="Start Recording" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" MinHeight="38" Padding="20,6" Margin="0,0,12,0"/>
      <Button Content="Pause" Tag="" Command="{Binding PauseCommand}" Style="{StaticResource GlyphButton}"/>
      <Button Content="Resume" Tag="" Command="{Binding ResumeCommand}" Style="{StaticResource GlyphButton}"/>
      <Button Content="Stop" Tag="" Command="{Binding StopCommand}" Style="{StaticResource GlyphButton}"/>
      <Button Content="Cancel" Tag="" Command="{Binding CancelCommand}" Style="{StaticResource GlyphButton}" ToolTip="Cancel countdown or recording; intermediate files retained"/>
    </StackPanel>
  </Grid>
</UserControl>
