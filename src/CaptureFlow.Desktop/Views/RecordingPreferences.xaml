<UserControl x:Class="CaptureFlow.Desktop.Views.RecordingPreferences" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel IsEnabled="{Binding CanEditPreferences}">
    <TextBlock Text="Capture setup" Style="{StaticResource Heading}"/>
    <TextBlock Text="Recording mode" Style="{StaticResource Label}" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="Recording mode"/>
    <StackPanel Visibility="{Binding IsScreen, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Screen source" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ScreenSourceOptions}" SelectedItem="{Binding SelectedScreenSource}" AutomationProperties.Name="Screen capture source"/></StackPanel><StackPanel Visibility="{Binding UsesMonitor, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Monitor" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Name" AutomationProperties.Name="Monitor selection"/></StackPanel>
    <StackPanel Visibility="{Binding IsWindowSource, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Application window" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ApplicationWindows}" SelectedItem="{Binding SelectedApplicationWindow}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Application window selection"/><Button Content="Refresh application windows" Command="{Binding RefreshWindowsCommand}" Margin="0,10,0,0"/></StackPanel>
    <StackPanel Visibility="{Binding IsRegionSource, Converter={StaticResource BoolVisibility}}"><Button Content="Select Region" Command="{Binding SelectRegionCommand}" Margin="0,12,0,0"/><TextBlock Text="{Binding RegionDescription}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel>
    <TextBlock Text="{Binding SourceSelectionMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,0" Visibility="{Binding IsScreen, Converter={StaticResource BoolVisibility}}"/>
    <Button Content="Refresh video &amp; audio devices" Command="{Binding RefreshDevicesCommand}" Margin="0,10,0,0"/>
    <TextBlock Text="Countdown" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding CountdownOptions}" SelectedItem="{Binding SelectedCountdown}" AutomationProperties.Name="Countdown preference"/>
    <TextBlock Text="Screen Only and Screen + Webcam support Entire Screen, Application Window and Custom Region sources. Webcam Only uses the camera without screen capture." Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0"/>
</StackPanel>
</UserControl>


