<UserControl x:Class="CaptureFlow.Desktop.Views.StoragePreferences" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
    <TextBlock Text="Recording storage" Style="{StaticResource Heading}"/>
    <TextBlock Text="Output folder" Style="{StaticResource Label}" Margin="0,0,0,6"/>
    <TextBox Text="{Binding OutputFolder, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Output folder" ToolTip="Select and copy this path, or choose an existing folder below."/>
    <WrapPanel Margin="0,12,0,0"><Button Content="Choose folder…" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,8" ToolTip="Choose a shared folder for screen and audio recordings, and browse existing MP4, WAV and MP3 files."/><Button Content="Open folder ↗" Command="{Binding OpenFolderCommand}" Margin="0,0,0,8" ToolTip="Open the selected folder in File Explorer. Available when the folder exists."/></WrapPanel>
    <TextBlock Text="{Binding LibraryStatus}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
</StackPanel>
</UserControl>


