<UserControl x:Class="CaptureFlow.Desktop.Views.CompositePreviewEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="True">
        <Viewbox Stretch="Uniform">
            <Grid Width="{Binding PreviewPixelWidth}" Height="{Binding PreviewPixelHeight}">
                <Image Source="{Binding CameraPreview}" Stretch="Fill" AutomationProperties.Name="Live screen and webcam composition"/>
                <Canvas x:Name="EditorCanvas" Visibility="{Binding IsCameraPreviewing, Converter={StaticResource BoolVisibility}}">
                    <Grid Canvas.Left="{Binding OverlayLeft}" Canvas.Top="{Binding OverlayTop}" Width="{Binding OverlayPixelWidth}" Height="{Binding OverlayPixelHeight}">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style></Grid.Style>
                        <Thumb Cursor="SizeAll" DragStarted="MoveStarted" DragDelta="MoveDelta" AutomationProperties.Name="Move webcam overlay" ToolTip="Drag the webcam overlay. Only raw video is exported; these handles are not included.">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#01000000" BorderBrush="#BFFFFFFF" BorderThickness="2"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Thumb Width="{Binding OverlayHandleSize}" Height="{Binding OverlayHandleSize}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="ResizeStarted" DragDelta="ResizeDelta" AutomationProperties.Name="Resize webcam overlay" ToolTip="Drag to resize while preserving aspect ratio.">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#7775FF" BorderBrush="#F3F5FF" BorderThickness="2" CornerRadius="4"><Viewbox Margin="4"><TextBlock Text="↘" Foreground="White" FontSize="24"/></Viewbox></Border></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Grid>
                </Canvas>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
