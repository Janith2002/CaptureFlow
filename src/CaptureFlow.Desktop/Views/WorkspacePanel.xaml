<UserControl x:Class="CaptureFlow.Desktop.Views.WorkspacePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource PanelHeader}"/><ContentPresenter Grid.Row="1" Content="{Binding Body, RelativeSource={RelativeSource AncestorType=UserControl}}"/></Grid></Border>
</UserControl>
