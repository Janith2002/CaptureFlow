<UserControl x:Class="CaptureFlow.Desktop.Views.RecoverySettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
<TextBlock Text="Recovery &amp; Protection" Style="{StaticResource Heading}"/>
<TextBlock Text="Protect intermediate recordings and unsaved editor projects. Recovery is best effort; damaged or missing media may not be recoverable." Style="{StaticResource MutedText}" Margin="0,8,0,18"/>
<CheckBox Content="Enable automatic recording recovery" IsChecked="{Binding RecordingEnabled}" Margin="0,0,0,12"/>
<CheckBox Content="Enable editor autosave" IsChecked="{Binding EditorAutosaveEnabled}" Margin="0,0,0,12"/>
<TextBlock Text="Autosave interval (15–300 seconds)"/><TextBox AutomationProperties.Name="Editor autosave interval in seconds" Text="{Binding AutosaveSeconds}" Margin="0,8,0,12"/>
<TextBlock Text="Recovery metadata and autosave location"/><TextBox AutomationProperties.Name="Recovery storage location" Text="{Binding StorageLocation}" Margin="0,8,0,12"/>
<TextBlock Text="Recording media remains beside the configured output folder in .captureflow-work. This location stores metadata, editor snapshots and recovery jobs. No age-based deletion is performed." Style="{StaticResource MutedText}"/>
<Button Content="Save protection preferences" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,16,0,16"/>
<TextBlock Text="{Binding Usage}" Style="{StaticResource MutedText}"/>
<CheckBox Content="Automatically archive finished journals (no media deletion)" IsChecked="{Binding AutoArchiveFinished}" Margin="0,16,0,12"/>
<TextBlock Text="Minimum age for confirmed metadata cleanup (0–3650 days)"/><TextBox Text="{Binding TerminalRetentionDays}" AutomationProperties.Name="Recovery terminal metadata retention days" Margin="0,8,0,12"/>
<TextBlock Text="Save preferences before cleanup. Incomplete, dismissed and orphaned data remains protected. Cleanup never deletes captured media or explicit editor projects." Style="{StaticResource MutedText}"/>
<WrapPanel Margin="0,12,0,12"><Button Content="Inspect storage" Command="{Binding InspectStorageCommand}" Margin="0,0,8,0"/><Button Content="Clean terminal metadata…" Command="{Binding CleanupCommand}"/></WrapPanel>
<ListBox ItemsSource="{Binding Inventory}" MaxHeight="200" AutomationProperties.Name="Recovery storage inventory"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Classification}" FontWeight="SemiBold"/><TextBlock Text="{Binding Folder}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock Text="Recovery sessions" Style="{StaticResource Heading}" Margin="0,22,0,12"/>
<ListBox AutomationProperties.Name="Recoverable recording and editor sessions" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}" MaxHeight="320" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
<ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8">
<TextBlock Text="{Binding ModeLabel}" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Record.State, StringFormat=Last confirmed state: {0}}"/>
<TextBlock Text="{Binding Record.DurationSeconds, StringFormat=Approximate active duration: {0:0.0} seconds}"/>
<TextBlock Text="{Binding Record.Updated, StringFormat=Last update: {0:g}}"/>
<TextBlock Text="{Binding Record.WorkDirectory}" TextWrapping="Wrap"/>
<TextBlock Text="{Binding Warning}" TextWrapping="Wrap"/>
<ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.7"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<WrapPanel Margin="0,16,0,12"><Button Content="Recover / Restore editor" Command="{Binding RecoverCommand}" Margin="0,0,8,8"/><Button Content="Open Folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8"/><Button Content="Dismiss" Command="{Binding DismissCommand}" Margin="0,0,8,8"/><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/><Button Content="Cancel recovery" Command="{Binding CancelCommand}" Margin="0,0,8,8"/></WrapPanel>
<TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}"/>
</StackPanel></UserControl>
