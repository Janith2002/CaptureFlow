<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CaptureFlow.Desktop.Views" x:Class="CaptureFlow.Desktop.Views.EditorPage" Focusable="True" PreviewKeyDown="EditorKeyDown">
  <Grid x:Name="WorkspaceViewport" SizeChanged="PremiumSizeChanged">
    <Grid.Resources>
      <Style TargetType="Button" BasedOn="{StaticResource CompactButton}"/>
      <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="30"/>
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="30"/>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition x:Name="PreviewRow" Height="3*" MinHeight="156"/>
      <RowDefinition Height="6"/>
      <RowDefinition x:Name="TimelineRow" Height="2*" MinHeight="154"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6">
      <Button DockPanel.Dock="Right" Content="Export" Click="ShowExport" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="18,4"/>
      <TextBlock DockPanel.Dock="Right" Text="{Binding ProjectDisplay}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
      <Menu>
        <MenuItem Header="Monitor">
          <MenuItem Header="Focus preview / restore timeline" Click="ToggleMonitorFocus"/>
          <MenuItem Header="Update edited preview" Command="{Binding PreviewCommand}"/>
          <MenuItem Header="Fullscreen" Click="PreviewFullscreen"/>
          <MenuItem Header="Mute / unmute preview" Click="PreviewMute"/>
          <MenuItem Header="Audition source audio" Click="AuditionSource"/>
          <MenuItem Header="Crop selected source" Click="BeginCrop"/>
          <MenuItem StaysOpenOnClick="True">
            <MenuItem.Header>
              <StackPanel>
                <TextBlock Text="Preview volume" FontSize="11"/>
                <Slider Width="150" Minimum="0" Maximum="1" Value="{Binding ElementName=Player, Path=PlaybackVolume, Mode=TwoWay}" AutomationProperties.Name="Preview playback volume"/>
              </StackPanel>
            </MenuItem.Header>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="Project">
          <MenuItem Header="New" Command="{Binding NewCommand}"/>
          <MenuItem Header="Open project" Command="{Binding OpenProjectCommand}"/>
          <MenuItem Header="Save project" Command="{Binding SaveProjectCommand}"/>
          <MenuItem Header="Import media" Command="{Binding ImportCommand}"/>
        </MenuItem>
        <MenuItem Header="Edit">
          <MenuItem Header="Add clip" Command="{Binding AddClipCommand}"/>
          <MenuItem Header="Cut" Command="{Binding CutCommand}"/>
          <MenuItem Header="Copy" Command="{Binding CopyCommand}"/>
          <MenuItem Header="Paste" Command="{Binding PasteCommand}"/>
          <MenuItem Header="Ripple delete" Command="{Binding RippleDeleteCommand}"/>
          <MenuItem Header="Join clips" Command="{Binding JoinCommand}"/>
        </MenuItem>
        <MenuItem Header="View">
          <MenuItem Header="Media bin" Click="ToggleMediaDock" IsCheckable="True" IsChecked="{Binding ElementName=MediaDock, Path=IsVisible, Mode=OneWay}"/>
          <MenuItem Header="Inspector" Click="ToggleInspectorDock" IsCheckable="True" IsChecked="{Binding ElementName=InspectorDock, Path=IsVisible, Mode=OneWay}"/>
          <MenuItem Header="Reset layout" Command="{Binding ResetEditorWorkspaceCommand}"/>
        </MenuItem>
      </Menu>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MediaColumn" Width="200"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*" MinWidth="200"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="260"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="MediaDock" Style="{StaticResource DockSurface}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Import media" Tag="" Command="{Binding ImportCommand}" Style="{StaticResource GlyphButton}"/>
              <TextBlock Text="MEDIA BIN" Style="{StaticResource DockTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox Text="{Binding MediaSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search imported media" ToolTip="Search imported media" Margin="0,0,0,6"/>
          </StackPanel>
          <ListBox ItemContainerStyle="{StaticResource MediaBinItem}" Grid.Row="1" ItemsSource="{Binding FilteredMedia}" SelectedItem="{Binding SelectedMedia}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" x:Name="MediaList" PreviewMouseLeftButtonDown="MediaDragBegin" PreviewMouseMove="MediaDragMove">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,8">
                  <Grid Height="82">
                    <TextBlock Text="♫" Foreground="#B7B6FF" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                  </Grid>
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="2" Content="Add to timeline" Command="{Binding AddClipCommand}" Margin="0,6,0,0"/>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" DragCompleted="WorkspaceDragCompleted"/>
      <Border Grid.Column="2" Style="{StaticResource DockSurface}" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewPlaybackHint}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviewPlaybackHint}"/>
            <TextBlock Text="PROGRAM" Style="{StaticResource DockTitle}" VerticalAlignment="Center" Margin="4,0,12,0"/>
            <ComboBox ItemsSource="{Binding PreviewQualityOptions}" SelectedItem="{Binding PreviewQuality}" Width="84" AutomationProperties.Name="Preview quality" HorizontalAlignment="Left"/>
            <Button Content="Update preview" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding PreviewCommand}"/>
          </DockPanel>
          <local:LibraryMediaPlayer Grid.Row="1" x:Name="Player" Compact="True" MonitorOnly="True"/>
          <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeDisplay}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="Jump to start" Tag="" Style="{StaticResource GlyphButton}" Click="JumpStart"/>
              <Button Content="Previous frame" Tag="" Style="{StaticResource GlyphButton}" Click="FrameBack"/>
              <Button Content="Play" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding PlayPreviewCommand}"/>
              <Button Content="Pause" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding PausePreviewCommand}"/>
              <Button Content="Stop" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding StopPreviewCommand}"/>
              <Button Content="Next frame" Tag="" Style="{StaticResource GlyphButton}" Click="FrameForward"/>
              <Button Content="Jump to end" Tag="" Style="{StaticResource GlyphButton}" Click="JumpEnd"/>
            </StackPanel>
          </DockPanel>
          <Border Grid.RowSpan="3" Background="{StaticResource CanvasBrush}" Visibility="{Binding ElementName=AuditionPanel, Path=Visibility}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="AuditionPanel" Visibility="Collapsed">
                <TextBlock Text="Original source — before edits. Use this to review detected silence; the timeline remains unchanged." Style="{StaticResource MutedText}" Margin="0,10"/>
                <local:LibraryMediaPlayer x:Name="SourcePlayer" Height="320"/>
                <Button Content="Close source audition" Click="CloseAudition" Margin="0,8,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.RowSpan="3" Background="{StaticResource CanvasBrush}" Visibility="{Binding ElementName=CropPanel, Path=Visibility}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="CropPanel" Visibility="Collapsed">
                <TextBlock Text="Source crop: drag a rectangle, then Apply crop. This view shows the original source before effects." Style="{StaticResource MutedText}" Margin="0,10"/>
                <Grid x:Name="CropSurface" Height="220" Background="Black" MouseLeftButtonDown="CropBegin" MouseMove="CropMove" MouseLeftButtonUp="CropEnd">
                  <MediaElement x:Name="SourceVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"/>
                  <Canvas IsHitTestVisible="False">
                    <Border x:Name="CropRectangle" BorderBrush="#A9A0FF" BorderThickness="2" Background="#307775FF"/>
                  </Canvas>
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Apply crop" Click="ApplyCrop"/>
                  <Button Content="Cancel crop" Click="CancelCrop" Margin="8,0,0,0"/>
                  <Button Content="Clear crop" Command="{Binding ClearCropCommand}" Margin="8,0,0,0"/>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeDirection="Columns" DragCompleted="WorkspaceDragCompleted"/>
      <Border x:Name="InspectorDock" Grid.Column="4" Style="{StaticResource DockSurface}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel IsEnabled="{Binding CanEdit}">
            <TextBlock Text="INSPECTOR" Style="{StaticResource DockTitle}"/>
            <TextBlock Text="Timing and source range" Style="{StaticResource Label}"/>
            <TextBlock Text="Timeline start (seconds)" Style="{StaticResource Label}"/>
            <TextBox AutomationProperties.Name="Clip Start" Text="{Binding ClipStart}"/>
            <TextBlock Text="Source trim in / out (seconds)" Style="{StaticResource Label}"/>
            <TextBox AutomationProperties.Name="Trim In" Text="{Binding TrimIn}"/>
            <TextBox AutomationProperties.Name="Trim Out" Text="{Binding TrimOut}" Margin="0,6,0,0"/>
            <TextBlock Text="Speed (0.25–4)" Style="{StaticResource Label}"/>
            <TextBox AutomationProperties.Name="Clip Speed" Text="{Binding ClipSpeed}"/>
            <Expander Header="Audio &amp; fades" IsExpanded="False" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="AUDIO · mix and fades" Style="{StaticResource DockTitle}" Margin="0,12,0,4"/>
                <Slider Minimum="0" Maximum="2" Value="{Binding ClipVolume}" AutomationProperties.Name="Clip volume slider" ToolTip="Clip gain; Apply clip properties commits the value"/>
                <TextBox AutomationProperties.Name="Clip Volume" Text="{Binding ClipVolume}"/>
                <CheckBox Content="Mute clip audio" IsChecked="{Binding ClipMuted}" Margin="0,8,0,0"/>
                <TextBlock Text="Fade in / out (seconds)" Style="{StaticResource Label}"/>
                <TextBox AutomationProperties.Name="Fade In" Text="{Binding FadeIn}"/>
                <TextBox AutomationProperties.Name="Fade Out" Text="{Binding FadeOut}" Margin="0,6,0,0"/>
              </StackPanel>
            </Expander>
            <Expander Header="Transform &amp; text" IsExpanded="False" Margin="0,10,0,0">
              <StackPanel>
                <StackPanel IsEnabled="{Binding HasVideoSelection}">
                  <TextBlock Text="TRANSFORM" Style="{StaticResource DockTitle}" Margin="0,12,0,4"/>
                  <TextBlock Text="{Binding CropDescription}" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="Rotate video" Style="{StaticResource Label}"/>
                  <ComboBox ItemsSource="{Binding RotationOptions}" SelectedItem="{Binding Rotation}"/>
                  <TextBlock Text="Video scale (0.1–3; centered)" Style="{StaticResource Label}"/>
                  <TextBox AutomationProperties.Name="Video Scale" Text="{Binding VideoScale}"/>
                  <Button Content="Reset transform" Command="{Binding ResetTransformCommand}" Margin="0,6"/>
                  <TextBlock Text="TEXT" Style="{StaticResource DockTitle}" Margin="0,12,0,4"/>
                  <TextBlock Text="Text overlay" Style="{StaticResource Label}"/>
                  <TextBox AutomationProperties.Name="Text" Text="{Binding Text}" AcceptsReturn="True" Height="55"/>
                  <TextBlock Text="Text X / Y (0–1)" Style="{StaticResource Label}"/>
                  <TextBox AutomationProperties.Name="Text X" Text="{Binding TextX}"/>
                  <TextBox AutomationProperties.Name="Text Y" Text="{Binding TextY}" Margin="0,6,0,0"/>
                  <TextBlock Text="Text size at 1080p / color (#RRGGBB)" Style="{StaticResource Label}"/>
                  <TextBox AutomationProperties.Name="Text Size" Text="{Binding TextSize}"/>
                  <TextBox AutomationProperties.Name="Text Color" Text="{Binding TextColor}" Margin="0,6,0,0"/>
                </StackPanel>
              </StackPanel>
            </Expander>
            <Button Content="Apply clip properties" Command="{Binding ApplyClipCommand}" Margin="0,12,0,0"/>
            <Expander Header="Animation" IsExpanded="False" Margin="0,12,0,0">
              <StackPanel IsEnabled="{Binding HasSelection}">
                <TextBlock Text="{Binding AnimationReadout}" Style="{StaticResource MutedText}"/>
                <ComboBox ItemsSource="{Binding AnimationProperties}" SelectedItem="{Binding AnimationProperty}" AutomationProperties.Name="Animated property"/>
                <TextBlock Text="Value: X/Y −1…1 canvas offset; scale 0.1…3; rotation −360…360°; opacity 0…1; gain 0…2" Style="{StaticResource MutedText}"/>
                <TextBox Text="{Binding KeyframeValue, ValidatesOnExceptions=True}" AutomationProperties.Name="Keyframe value"/>
                <ComboBox ItemsSource="{Binding Interpolations}" SelectedItem="{Binding Interpolation}" AutomationProperties.Name="Keyframe interpolation"/>
                <Button Content="Add at playhead" Command="{Binding AddKeyframeCommand}" ToolTip="Add a clip-local keyframe at the current timeline playhead"/>
                <ListBox ItemsSource="{Binding ClipKeyframes}" SelectedItem="{Binding SelectedKeyframe}" MaxHeight="140" AutomationProperties.Name="Clip keyframes">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Property}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Time, StringFormat={}{0:0.000}s}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Value, StringFormat={}{0:0.###}}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Selected keyframe time (local seconds)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding KeyframeTime, ValidatesOnExceptions=True}" AutomationProperties.Name="Keyframe time"/>
                <WrapPanel>
                  <Button Content="Move / update" Command="{Binding UpdateKeyframeCommand}"/>
                  <Button Content="Delete key" Command="{Binding DeleteKeyframeCommand}" Margin="6,0,0,0"/>
                </WrapPanel>
                <Button Content="Reset animation" Command="{Binding ResetAnimationCommand}"/>
              </StackPanel>
            </Expander>
            <Expander Header="Transitions" IsExpanded="False" Margin="0,12,0,0">
              <StackPanel IsEnabled="{Binding HasVideoSelection}">
                <ComboBox ItemsSource="{Binding TransitionPlacements}" SelectedItem="{Binding TransitionPlacement}" AutomationProperties.Name="Transition edge"/>
                <ComboBox ItemsSource="{Binding TransitionTypes}" SelectedItem="{Binding TransitionType}" AutomationProperties.Name="Transition type"/>
                <TextBlock Text="Duration (seconds)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding TransitionDuration, ValidatesOnExceptions=True}" AutomationProperties.Name="Transition duration"/>
                <TextBlock Text="Dissolve uses incoming source before trim-in over the previous clip's tail. Requires adjacent video clips and sufficient source handle. Fades affect video; audio fade handles are separate." Style="{StaticResource MutedText}"/>
                <WrapPanel>
                  <Button Content="Apply transition" Command="{Binding ApplyTransitionCommand}"/>
                  <Button Content="Delete edge" Command="{Binding DeleteTransitionCommand}" Margin="6,0,0,0"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            <Expander Header="Track mix &amp; silence" IsExpanded="False" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="Track volume (0–2)" Style="{StaticResource Label}"/>
                <TextBox AutomationProperties.Name="Track Volume" Text="{Binding TrackVolume}"/>
                <CheckBox Content="Mute track" IsChecked="{Binding TrackMuted}" Margin="0,8,0,0"/>
                <Button Content="Apply track mix" Command="{Binding ApplyTrackCommand}" Margin="0,10,0,0"/>
                <TextBlock Text="Silence threshold dB / minimum seconds" Style="{StaticResource Label}"/>
                <TextBox AutomationProperties.Name="Silence Threshold" Text="{Binding SilenceThreshold}"/>
                <TextBox AutomationProperties.Name="Minimum Silence" Text="{Binding MinimumSilence}" Margin="0,6,0,0"/>
                <Button Content="Detect silence" Command="{Binding DetectSilenceCommand}" Margin="0,10,0,0"/>
                <Button Content="Remove detected silence" Command="{Binding RemoveSilenceCommand}" Margin="0,8,0,0"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <GridSplitter x:Name="TimelineDivider" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" DragCompleted="WorkspaceDragCompleted"/>
    <Border x:Name="TimelineDock" Grid.Row="3" Style="{StaticResource DockSurface}" Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="38"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Fit" Click="FitTimeline" ToolTip="Fit timeline"/>
            <Button Content="Zoom out" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding ZoomOutCommand}"/>
            <Button Content="Zoom in" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding ZoomInCommand}"/>
            <Slider Width="80" Minimum="0.005" Maximum="2000" Value="{Binding Zoom}" AutomationProperties.Name="Timeline zoom"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="Select" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding SelectToolCommand}"/>
            <Button Content="Trim" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding TrimToolCommand}"/>
            <Button Content="Split" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding SplitCommand}"/>
            <Button Content="Delete" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding DeleteCommand}"/>
            <Button Content="Undo" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding UndoCommand}"/>
            <Button Content="Redo" Tag="" Style="{StaticResource GlyphButton}" Command="{Binding RedoCommand}"/>
            <ToggleButton Content="Snap" IsChecked="{Binding SnappingEnabled}" ToolTip="Snap to clips, playhead and zero" Margin="8,3" Padding="8,2"/>
            <ComboBox Width="88" ItemsSource="{Binding TrackOptions}" SelectedIndex="{Binding SelectedTrack}" AutomationProperties.Name="Timeline target track" ToolTip="Target track"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="TimelineViewportSizeChanged">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="100"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,25,0,0">
              <Border Style="{StaticResource TrackHeader}" Height="{Binding ElementName=Timeline, Path=TrackHeight}">
                <StackPanel>
                  <TextBlock Text="{Binding VideoTrack.Name}" FontSize="10" Foreground="{StaticResource CyanBrush}"/>
                  <WrapPanel>
                    <ToggleButton Content="Lock" IsChecked="{Binding VideoTrack.Locked, Mode=OneWay}" Command="{Binding ToggleTrackLockCommand}" CommandParameter="0" ToolTip="Toggle enforced clip edit lock" Padding="3" FontSize="9" MinHeight="20"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TrackHeader}" Height="{Binding ElementName=Timeline, Path=TrackHeight}">
                <StackPanel>
                  <TextBlock Text="{Binding AudioTrack.Name}" FontSize="10" Foreground="{StaticResource CyanBrush}"/>
                  <WrapPanel>
                    <ToggleButton Content="Lock" IsChecked="{Binding AudioTrack.Locked, Mode=OneWay}" Command="{Binding ToggleTrackLockCommand}" CommandParameter="1" ToolTip="Toggle enforced clip edit lock" Padding="3" FontSize="9" MinHeight="20"/>
                    <ToggleButton Content="Mute" IsChecked="{Binding AudioTrack.Muted, Mode=OneWay}" Command="{Binding ToggleTrackMuteCommand}" CommandParameter="1" ToolTip="Toggle actual track audio mute" Padding="3" FontSize="9" MinHeight="20"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource TrackHeader}" Height="{Binding ElementName=Timeline, Path=TrackHeight}">
                <StackPanel>
                  <TextBlock Text="{Binding MusicTrack.Name}" FontSize="10" Foreground="{StaticResource CyanBrush}"/>
                  <WrapPanel>
                    <ToggleButton Content="Lock" IsChecked="{Binding MusicTrack.Locked, Mode=OneWay}" Command="{Binding ToggleTrackLockCommand}" CommandParameter="2" ToolTip="Toggle enforced clip edit lock" Padding="3" FontSize="9" MinHeight="20"/>
                    <ToggleButton Content="Mute" IsChecked="{Binding MusicTrack.Muted, Mode=OneWay}" Command="{Binding ToggleTrackMuteCommand}" CommandParameter="2" ToolTip="Toggle actual track audio mute" Padding="3" FontSize="9" MinHeight="20"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" x:Name="TimelineScroll">
              <local:EditorTimeline x:Name="Timeline" HorizontalAlignment="Left"/>
            </ScrollViewer>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4">
    <DockPanel MinHeight="26">
      <Button DockPanel.Dock="Right" Content="Cancel processing" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" MinHeight="22" Padding="8,0"/>
      <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      <ProgressBar Width="80" Value="{Binding Progress}" Maximum="1" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
    </DockPanel>
    <Border Style="{StaticResource DockSurface}" Margin="0,4,0,0" Padding="10,8" Visibility="{Binding ExportStatusVisible, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Persistent export status">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissExportStatusCommand}" Padding="8,2"/>
          <TextBlock Text="{Binding ExportHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ExportJobFormat}" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ExportProgressText}" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ExportElapsed, StringFormat=Elapsed {0}}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding ExportFilename}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExportOutputPath}"/>
        <TextBlock Text="{Binding ExportOutputPath}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="{Binding ExportDetails}" FontSize="11" TextWrapping="Wrap" Margin="0,3"/>
        <ProgressBar Value="{Binding ExportProgressValue, Mode=OneWay}" Maximum="1" IsIndeterminate="{Binding ExportIndeterminate}" Height="4" Visibility="{Binding ExportActive, Converter={StaticResource BoolVisibility}}"/>
        <WrapPanel Margin="0,4,0,0">
          <TextBlock Text="{Binding ExportFileSize}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button Content="Cancel export" Command="{Binding CancelExportCommand}" Visibility="{Binding ExportActive, Converter={StaticResource BoolVisibility}}" Padding="8,2"/>
          <Button Content="Open folder" Command="{Binding OpenExportFolderCommand}" Padding="8,2"/>
          <Button Content="Play / open file" Command="{Binding OpenExportFileCommand}" Margin="6,0" Padding="8,2"/>
          <Button Content="Retry as new file" Command="{Binding RetryExportCommand}" Padding="8,2"/>
        </WrapPanel>
        <Expander Header="Technical details" FontSize="11">
          <TextBox Text="{Binding ExportTechnicalDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
        </Expander>
      </StackPanel>
    </Border>
    </StackPanel>
    <Border x:Name="ExportPanel" Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Right" Width="300" Style="{StaticResource DockSurface}" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Close export" Tag="" Style="{StaticResource GlyphButton}" Click="HideExport"/>
            <TextBlock Text="EXPORT SETTINGS" Style="{StaticResource DockTitle}"/>
          </DockPanel>
          <StackPanel IsEnabled="{Binding CanEdit}">
            <TextBlock Text="Export" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding ExportFormat}"/>
            <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding ExportResolution}" Margin="0,6"/>
            <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding ExportFps}"/>
            <TextBlock Text="CRF 16–30" VerticalAlignment="Center" Margin="0,10,0,4"/>
            <TextBox AutomationProperties.Name="Export Crf" Text="{Binding ExportCrf}"/>
            <TextBlock Text="MP3 kbps" VerticalAlignment="Center" Margin="0,10,0,4"/>
            <ComboBox ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding Mp3Bitrate}"/>
            <Button Content="Export new file" Tag="" ToolTip="Export new file" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
