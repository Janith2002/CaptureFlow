<UserControl x:Class="CaptureFlow.Desktop.Views.AudioRecorderPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CaptureFlow.Desktop.Views">
<StackPanel>
    <Border Style="{StaticResource Card}" BorderBrush="#28605D" Margin="0,0,0,16"><StackPanel><DockPanel Margin="0,0,0,14"><TextBlock DockPanel.Dock="Right" Text="{Binding Audio.SelectedFormat, StringFormat=Output: {0}}" Foreground="#29CBDF"/><TextBlock Text="AUDIO-ONLY SESSION" FontSize="11" Foreground="#29CBDF" FontWeight="SemiBold"/></DockPanel><views:AudioSessionControls DataContext="{Binding Audio}"/>
        <Border Background="#111823" BorderBrush="#354057" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="Live audio levels" FontWeight="SemiBold"/><TextBlock Text="Real-time meters are not yet implemented. The recording timer and status above reflect actual audio capture." Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
    </StackPanel></Border>
    <WrapPanel x:Name="AudioCards">
        <Border Style="{StaticResource Card}" Width="{Binding ActualWidth, ElementName=AudioCards, Converter={StaticResource CardWidthConverter}}" Margin="0,0,16,16"><views:AudioRecordingPreferences DataContext="{Binding Audio}"/></Border>
        <Border Style="{StaticResource Card}" Width="{Binding ActualWidth, ElementName=AudioCards, Converter={StaticResource CardWidthConverter}}" Margin="0,0,0,16"><views:AudioOnlyInputs DataContext="{Binding Audio}"/></Border>
    </WrapPanel>
    <Border Style="{StaticResource Card}"><views:StoragePreferences/></Border>
</StackPanel>
</UserControl>


