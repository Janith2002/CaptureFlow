<UserControl x:Class="CaptureFlow.Desktop.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CaptureFlow.Desktop.Views">
<StackPanel>
    <Border Background="#232840" CornerRadius="10" Padding="14" Margin="0,0,0,18"><TextBlock Text="Screen and audio preferences are independent and shared with their respective recorder pages. Video quality, shortcut and tray preferences can be saved across restarts. Other recording preferences last this session." Style="{StaticResource MutedText}"/></Border>
    <TabControl Style="{StaticResource SettingsTabs}" SelectedIndex="{Binding SelectedSettingsTab}">
        <TabItem Header="General"><StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,16"><views:RecordingExperienceSettings DataContext="{Binding Experience}"/></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="General" Style="{StaticResource Heading}"/><TextBlock Text="CaptureFlow opens on the dashboard. Choose Screen Recorder or Audio Recorder to configure your capture." Style="{StaticResource MutedText}"/><CheckBox Content="Launch at Windows sign-in" IsEnabled="False" Margin="0,20,0,16" ToolTipService.ShowOnDisabled="True" ToolTip="Startup integration is not yet implemented."/><CheckBox Content="Minimize and close to system tray" IsChecked="{Binding Shortcuts.MinimizeToTray}"/><Button Content="Save tray preference" Command="{Binding Shortcuts.SaveCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock Text="{Binding Shortcuts.Message}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></TabItem>
        <TabItem Header="Screen recording"><StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,16"><views:RecordingPreferences DataContext="{Binding Screen}"/></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Screen.IsCameraMode, Converter={StaticResource BoolVisibility}}"><views:CameraControls DataContext="{Binding Screen}"/></Border><Border Style="{StaticResource Card}" Margin="0,0,0,16"><views:VideoPreferences DataContext="{Binding Screen}"/></Border><Border Style="{StaticResource Card}"><views:AudioPreferences DataContext="{Binding Screen}"/></Border></StackPanel></TabItem>
        <TabItem Header="Audio recording"><StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,16"><views:AudioRecordingPreferences DataContext="{Binding Audio}"/></Border><Border Style="{StaticResource Card}"><views:AudioOnlyInputs DataContext="{Binding Audio}"/></Border></StackPanel></TabItem>
        <TabItem Header="Storage"><Border Style="{StaticResource Card}"><views:StoragePreferences/></Border></TabItem>
        <TabItem Header="Keyboard shortcuts"><Border Style="{StaticResource Card}"><StackPanel DataContext="{Binding Shortcuts}">
<TextBlock Text="Global keyboard shortcuts" Style="{StaticResource Heading}"/>
<TextBlock Text="Control the active recording from any app. When idle, the last selected recorder page is used (Screen Recorder by default). Configure devices and preview there before starting." Style="{StaticResource MutedText}"/>
<CheckBox Content="Enable global shortcuts" IsChecked="{Binding Enabled}" Margin="0,18,0,16"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Start / Stop recording" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding StartStop, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Start or stop shortcut"/>
<TextBlock Grid.Row="1" Text="Pause / Resume recording" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PauseResume, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Pause or resume shortcut"/>
<TextBlock Grid.Row="2" Text="Toggle microphone mute" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ToggleMicrophone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Microphone mute shortcut"/>
<TextBlock Grid.Row="3" Text="Show / Hide CaptureFlow" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ToggleWindow, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Show or hide shortcut"/>
</Grid><TextBlock Text="Enter combinations such as Ctrl+Alt+R or Ctrl+Shift+F10. Letters, digits and F1–F24 are supported. Each action needs a unique combination." Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
<Button Content="Save shortcuts" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
<TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
</StackPanel></Border></TabItem>
        <TabItem Header="Appearance"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource Heading}"/><TextBlock Text="Dark theme" FontWeight="SemiBold"/><TextBlock Text="Charcoal surfaces with purple actions and teal status indicators. Additional themes are not yet implemented." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border></TabItem>
        <TabItem Header="Recovery &amp; Protection"><Border Style="{StaticResource Card}"><views:RecoverySettings DataContext="{Binding Recovery}"/></Border></TabItem>
        <TabItem Header="External tools"><Border Style="{StaticResource Card}"><StackPanel DataContext="{Binding ExternalTools}"><TextBlock Text="External FFmpeg installation" Style="{StaticResource Heading}"/><TextBlock Text="CaptureFlow does not bundle FFmpeg. Install a distribution that supplies libx264, AAC and libmp3lame, then select ffmpeg.exe. Matching ffprobe.exe must be in the same folder. Your absolute path is saved in user application data." Style="{StaticResource MutedText}" Margin="0,12,0,16"/><TextBox Text="{Binding Executable}" AutomationProperties.Name="External FFmpeg executable path"/><WrapPanel Margin="0,16,0,16"><Button Content="Browse…" Command="{Binding BrowseCommand}" Margin="0,0,8,0"/><Button Content="Validate and Save" Command="{Binding SaveCommand}"/></WrapPanel><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}"/></StackPanel></Border></TabItem>
    </TabControl>
</StackPanel>
</UserControl>






