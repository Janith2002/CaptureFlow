<UserControl x:Class="CaptureFlow.Desktop.Views.SessionControls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
    <WrapPanel>
        <StackPanel Width="220" Margin="0,0,16,12"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#A7B0C5"/><Style.Triggers><DataTrigger Binding="{Binding StatusLabel}" Value="Recording"><Setter Property="Fill" Value="#FF5E72"/></DataTrigger><DataTrigger Binding="{Binding StatusLabel}" Value="Paused"><Setter Property="Fill" Value="#F5BC62"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding StatusLabel}" Foreground="#B7B6FF"/></StackPanel><TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="42" Margin="0,10,0,0" AutomationProperties.Name="Video recording elapsed time"/></StackPanel>
        <StackPanel Width="340"><Button Content="●  Start Recording" Command="{Binding StartCommand}" FontSize="16" MinHeight="48" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12"/><UniformGrid Columns="4"><Button Content="Pause" Style="{StaticResource ToolbarButton}" Tag="&#xE769;" Command="{Binding PauseCommand}" Margin="0,0,6,0" Padding="8,6"/><Button Content="Resume" Style="{StaticResource ToolbarButton}" Tag="&#xE768;" Command="{Binding ResumeCommand}" Margin="0,0,6,0" Padding="8,6"/><Button Content="Stop" Style="{StaticResource ToolbarButton}" Tag="&#xE71A;" Command="{Binding StopCommand}" Margin="0,0,6,0" Padding="8,6"/><Button Content="Cancel" Style="{StaticResource ToolbarButton}" Tag="&#xE711;" Command="{Binding CancelCommand}" Padding="8,6" ToolTip="Cancel without publishing an MP4. Intermediate files are retained."/></UniformGrid></StackPanel>
    </WrapPanel>
    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
    <TextBlock Text="{Binding CaptureExclusionNotice}" Style="{StaticResource MutedText}" FontSize="11"/>
</StackPanel>
</UserControl>

