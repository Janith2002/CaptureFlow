<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaptureFlow.Desktop.Views.StudioAudioMixer">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="28"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="28"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <CheckBox DockPanel.Dock="Right" Content="Mute" IsChecked="{Binding MicrophoneMuted}" IsEnabled="{Binding MicrophoneEnabled}" AutomationProperties.Name="Mute Microphone"/>
        <CheckBox Content="Microphone" IsChecked="{Binding MicrophoneEnabled}" IsEnabled="{Binding CanEditPreferences}" HorizontalAlignment="Left"/>
      </DockPanel>
      <ProgressBar Grid.Row="1" Maximum="60" Value="{Binding MicrophoneMeter}" Height="5" VerticalAlignment="Center" AutomationProperties.Name="Microphone peak level"/>
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Right" Text="{Binding MicrophoneMeterText}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="Real recording samples only; no background capture"/>
        <Slider Style="{StaticResource VolumeSlider}" Value="{Binding MicrophoneVolume}" IsEnabled="{Binding MicrophoneEnabled}" AutomationProperties.Name="Microphone gain" MaxWidth="220" HorizontalAlignment="Stretch"/>
      </DockPanel>
    </Grid>
    <Grid Grid.Column="2" Visibility="{Binding IsScreen, Converter={StaticResource BoolVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="28"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <CheckBox DockPanel.Dock="Right" Content="Mute" IsChecked="{Binding SystemAudioMuted}" IsEnabled="{Binding SystemAudioEnabled}" AutomationProperties.Name="Mute System audio"/>
        <CheckBox Content="System audio" IsChecked="{Binding SystemAudioEnabled}" IsEnabled="{Binding CanEditPreferences}" HorizontalAlignment="Left"/>
      </DockPanel>
      <ProgressBar Grid.Row="1" Maximum="60" Value="{Binding SystemMeter}" Height="5" VerticalAlignment="Center" AutomationProperties.Name="System audio peak level"/>
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Right" Text="{Binding SystemMeterText}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="Real recording samples only; no background capture"/>
        <Slider Style="{StaticResource VolumeSlider}" Value="{Binding SystemAudioVolume}" IsEnabled="{Binding SystemAudioEnabled}" AutomationProperties.Name="System audio gain" MaxWidth="220" HorizontalAlignment="Stretch"/>
      </DockPanel>
    </Grid>
    <Border Grid.Column="1" Width="1" Background="{StaticResource BoundaryBrush}"/>
  </Grid>
</UserControl>
