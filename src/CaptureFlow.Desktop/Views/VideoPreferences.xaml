<UserControl x:Class="CaptureFlow.Desktop.Views.VideoPreferences" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
<StackPanel IsEnabled="{Binding CanEditQuality}">
    <DockPanel Margin="0,0,0,6"><Border DockPanel.Dock="Right" Background="#193C3B" CornerRadius="6" Padding="10,4"><TextBlock Text="MP4" Foreground="#29CBDF" FontSize="12" FontWeight="SemiBold"/></Border><TextBlock Text="Video" Style="{StaticResource Heading}" Margin="0"/></DockPanel>
    <TextBlock Text="Output resolution" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}" AutomationProperties.Name="Resolution" ToolTip="Aspect ratio is preserved. Portrait sources keep portrait orientation. 4K requires a 4K source."/>
    <TextBlock Text="Output frame rate" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding SelectedFrameRate}" AutomationProperties.Name="Frame rate"/>
    <TextBlock Text="Camera capture uses the reported device format above. Output scaling and frame sampling are applied separately." Style="{StaticResource MutedText}" Visibility="{Binding IsCameraMode, Converter={StaticResource BoolVisibility}}"/>
    <TextBlock Text="Quality preset" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}" AutomationProperties.Name="Video quality"/>
    <StackPanel Visibility="{Binding IsCustomQuality, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Custom video bitrate (kbps · 500–100000)" Style="{StaticResource Label}"/><TextBox Text="{Binding CustomBitrateText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom video bitrate"/><TextBlock Text="Suggested bitrates for this size and FPS" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding SelectedSuggestedBitrate}" AutomationProperties.Name="Suggested video bitrate"/></StackPanel>
    <TextBlock Text="{Binding QualitySummary}" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
    <TextBlock Text="Encoder" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding EncoderOptions}" SelectedItem="{Binding SelectedEncoder}" AutomationProperties.Name="Video encoder"/>
    <TextBlock Text="Hardware accelerates final export after capture. A fast lossless intermediate enables safe Auto fallback, but requires extra disk space. Explicit hardware selections require a successful check and never silently fall back." Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
    <TextBlock Text="FFmpeg executable" Style="{StaticResource Label}"/><TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="FFmpeg executable path" ToolTip="Use ffmpeg.exe on PATH or enter its full executable path."/>
    <WrapPanel Margin="0,14,0,14"><Button Content="Check available encoders" Command="{Binding CheckEncodersCommand}" Margin="0,0,10,8"/><Button Content="Save quality settings" Command="{Binding SaveQualitySettingsCommand}" Margin="0,0,0,8"/></WrapPanel>
    <StackPanel Visibility="{Binding IsScreen, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEditPreferences}">
        <TextBlock Text="Mouse Effects" Style="{StaticResource Heading}" Margin="0,16,0,14"/>
        <CheckBox Content="Show Cursor" IsChecked="{Binding ShowMouseCursor}" Margin="0,0,0,12"/>
        <CheckBox Content="Highlight Cursor" IsChecked="{Binding HighlightCursor}" Margin="0,0,0,12"/>
        <TextBlock Text="Highlight color" Style="{StaticResource Label}"/><ComboBox IsEditable="True" ItemsSource="{Binding MouseColorOptions}" Text="{Binding HighlightColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Highlight color" ToolTip="Select a color or enter #RRGGBB."/>
        <TextBlock Text="{Binding HighlightRadius, StringFormat=Highlight radius: {0:0} source pixels}" Style="{StaticResource Label}"/>
        <Slider Minimum="8" Maximum="100" Value="{Binding HighlightRadius}" AutomationProperties.Name="Highlight size" Margin="0,8,0,12"/>
        <TextBlock Text="{Binding HighlightOpacity, StringFormat=Highlight opacity: {0:P0}}" Style="{StaticResource Label}"/>
        <Slider Minimum="0.05" Maximum="1" Value="{Binding HighlightOpacity}" AutomationProperties.Name="Highlight opacity" Margin="0,8,0,12"/>
        <CheckBox Content="Show Mouse Click Effects" IsChecked="{Binding HighlightMouseClicks}" Margin="0,0,0,12"/>
        <WrapPanel><CheckBox Content="Show Left Clicks" IsChecked="{Binding ShowLeftClicks}" Margin="0,0,18,12"/><CheckBox Content="Show Right Clicks" IsChecked="{Binding ShowRightClicks}" Margin="0,0,0,12"/></WrapPanel>
        <TextBlock Text="Left click color" Style="{StaticResource Label}"/><ComboBox IsEditable="True" ItemsSource="{Binding MouseColorOptions}" Text="{Binding LeftClickColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Left click color" ToolTip="Select a color or enter #RRGGBB."/>
        <TextBlock Text="Right click color" Style="{StaticResource Label}"/><ComboBox IsEditable="True" ItemsSource="{Binding MouseColorOptions}" Text="{Binding RightClickColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Right click color" ToolTip="Select a color or enter #RRGGBB."/>
        <TextBlock Text="{Binding ClickDurationMilliseconds, StringFormat=Click duration: {0:0} ms}" Style="{StaticResource Label}"/>
        <Slider Minimum="100" Maximum="2000" Value="{Binding ClickDurationMilliseconds}" AutomationProperties.Name="Click animation duration" Margin="0,8,0,12"/>
        <TextBlock Text="{Binding MouseEffectsMessage}" Style="{StaticResource MutedText}"/>
    </StackPanel>
</StackPanel>
<TextBlock Text="{Binding QualityPreferencesMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
<TextBlock Text="{Binding EncoderMessage}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
<TextBlock Text="{Binding EncoderVerificationNotice}" Style="{StaticResource MutedText}" Foreground="#F4BF83" Margin="0,8,0,0"/>
<TextBlock Text="{Binding EncodingStatus}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
<TextBlock Text="H.264 video + optional AAC audio. FPS depends on source and encoder throughput; overload can repeat or skip source frames. FFmpeg is installed separately." Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0"/>
</StackPanel>
</UserControl>

