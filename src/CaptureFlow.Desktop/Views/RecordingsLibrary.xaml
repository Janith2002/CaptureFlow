<UserControl x:Class="CaptureFlow.Desktop.Views.RecordingsLibrary" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CaptureFlow.Desktop.Views">
<Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshRecordingsCommand}"/><StackPanel><TextBlock Text="Recording library" Style="{StaticResource Heading}" Margin="0"/><TextBlock Text="Find a capture. Replay a moment." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
        <StackPanel Width="175" Margin="0,0,12,8"><TextBlock Text="Recording type" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" AutomationProperties.Name="Recording type filter"/></StackPanel>
        <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="Search filenames" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search recordings"/></StackPanel>
        <StackPanel Width="150" Margin="0,0,0,8"><TextBlock Text="Sort" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="Sort recordings"/></StackPanel>
    </WrapPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*" MinWidth="260"/></Grid.ColumnDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="#111823" CornerRadius="10" Padding="20" Visibility="{Binding HasNoMatchingRecordings, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="No matching recordings" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Choose a folder containing MP4, MP3 or WAV files, or adjust your search and filters." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
            <ListView Grid.Row="1" Height="420" ItemsSource="{Binding RecordingsView}" SelectedItem="{Binding SelectedRecording}" MouseDoubleClick="RecordingDoubleClick" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Saved recordings">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#283248"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#35345D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate><DataTemplate><Grid Margin="0,8" ToolTip="{Binding FullPath}"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#232840" CornerRadius="8" Width="68" Height="52" Margin="0,0,12,0"><Grid><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="#B7B6FF" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="#A8B2C6" FontSize="11" Margin="0,5,0,0"><Run Text="{Binding Type, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Format, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Duration, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Size, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Date, StringFormat=Created · {0}}" Foreground="#A8B2C6" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" Foreground="#A8B2C6" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="{Binding Availability}" Foreground="#B7B6FF" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                </Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel Grid.Column="2"><views:LibraryMediaPlayer x:Name="Player" Height="360"/><Border Background="#111823" CornerRadius="8" Padding="12" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding SelectedRecording.Type}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedRecording.FullPath}" TextWrapping="Wrap" Foreground="#A8B2C6" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="{Binding SelectedRecording.Warning}" TextWrapping="Wrap" Foreground="#E8BC78" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border></StackPanel>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,16,0,0"><WrapPanel><Button Content="Open" Command="{Binding PlayRecordingCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Edit" Command="{Binding EditRecordingCommand}" Margin="0,0,8,8"/><Button Content="Open file location" Command="{Binding OpenRecordingFolderCommand}" Margin="0,0,8,8"/><TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,8" AutomationProperties.Name="New recording filename"/><Button Content="Rename" Command="{Binding RenameRecordingCommand}" Margin="0,0,8,8"/><Button Content="Delete…" Command="{Binding DeleteRecordingCommand}" Margin="0,0,0,8" ToolTip="Requires confirmation; supported local files go to the Recycle Bin."/></WrapPanel><TextBlock Text="{Binding LibraryStatus}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
</Grid>
</UserControl>
