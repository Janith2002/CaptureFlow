<Window x:Class="CaptureFlow.Desktop.Views.CountdownWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="pack://application:,,,/CaptureFlow.Desktop;component/Assets/Branding/CaptureFlow-New-Icon.ico" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Width="320" Height="340" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Title="CaptureFlow countdown" FontFamily="Segoe UI">
<Border Background="#F01B2232" CornerRadius="28" BorderBrush="#7775FF" BorderThickness="1" Padding="26">
<StackPanel HorizontalAlignment="Center">
<TextBlock Text="CaptureFlow" Foreground="#F3F5FF" FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center"/>
<TextBlock Text="Recording starts in" Foreground="#A7B0C5" Margin="0,12,0,0" HorizontalAlignment="Center"/>
<TextBlock x:Name="Number" Text="3" FontSize="112" FontWeight="SemiBold" Foreground="#B7B6FF" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform></TextBlock>
<Button Content="Cancel countdown" Click="CancelClicked" Padding="20,10" AutomationProperties.Name="Cancel recording countdown"/>
</StackPanel></Border>
</Window>
