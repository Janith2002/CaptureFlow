<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CaptureFlow.Desktop.Views" x:Class="CaptureFlow.Desktop.Views.ScreenRecorderPage" Loaded="WorkspaceLoaded" Unloaded="WorkspaceUnloaded" SizeChanged="PremiumSizeChanged">
  <UserControl.Resources>
    <Style x:Key="StudioSourceItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PanelBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource CompactButton}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="30"/>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="StudioWorkspace">
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*" MinHeight="145"/>
      <RowDefinition Height="6"/>
      <RowDefinition x:Name="MixerRow" Height="130"/>
      <RowDefinition Height="62"/>
      <RowDefinition Height="24"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ToggleButton x:Name="SourcesToggle" Content="Sources" IsChecked="{Binding ElementName=SourcesDock, Path=IsVisible, Mode=OneWay}" Click="ToggleSources" Padding="10,3" Margin="0,0,6,0"/>
        <CheckBox Content="Mixer" IsChecked="{Binding Screen.ShowStudioMixer}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ToggleButton Content="Inspector" IsChecked="{Binding ElementName=PropertiesDock, Path=IsVisible, Mode=OneWay}" Click="ToggleInspector" Padding="10,3"/>
      </StackPanel>
      <Menu DataContext="{Binding Screen}">
        <MenuItem Header="Workspace">
          <MenuItem Header="Reset layout" Command="{Binding ResetWorkspaceCommand}" Click="ResetResponsivePanels"/>
          <MenuItem Header="Open output folder" Command="{Binding OpenStudioOutputCommand}"/>
        </MenuItem>
      </Menu>
      <TextBlock Text="{Binding Screen.SelectedMode}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SourcesColumn" Width="200"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*" MinWidth="200"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition x:Name="PropertiesColumn" Width="260"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="SourcesDock" Style="{StaticResource DockSurface}" DataContext="{Binding Screen}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="SOURCES" Style="{StaticResource DockTitle}"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ListBox ItemContainerStyle="{StaticResource StudioSourceItem}" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BoundaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" ItemsSource="{Binding StudioSources}" SelectedItem="{Binding SelectedStudioSource}" MinHeight="100" AutomationProperties.Name="Active recording sources">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,6">
                      <DockPanel>
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource CyanBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource PurpleBrush}"/>
                      <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ComboBox ItemsSource="{Binding SupportedSourceTypes}" SelectedItem="{Binding SourceToAdd}" AutomationProperties.Name="Supported source to add" IsEnabled="{Binding CanEditPreferences}" Margin="0,10,0,6"/>
              <WrapPanel>
                <Button Content="Add source" Command="{Binding AddStudioSourceCommand}" Margin="0,0,6,6"/>
                <Button Content="Remove" Command="{Binding RemoveStudioSourceCommand}" Margin="0,0,0,6"/>
              </WrapPanel>
              <Expander Header="Recording presets" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="RECORDING PRESETS" Style="{StaticResource PanelHeader}" Margin="0,16,0,8"/>
                  <ComboBox ItemsSource="{Binding StudioPresets}" SelectedItem="{Binding SelectedStudioPreset}" DisplayMemberPath="Name" AutomationProperties.Name="Recording preset" IsEnabled="{Binding CanEditPreferences}"/>
                  <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Preset name" Margin="0,8,0,8" IsEnabled="{Binding CanEditPreferences}"/>
                  <WrapPanel>
                    <Button Content="Apply" Command="{Binding ApplyPresetCommand}" Margin="0,0,6,6"/>
                    <Button Content="Save new" Command="{Binding SavePresetCommand}" Margin="0,0,6,6"/>
                    <Button Content="Rename" Command="{Binding RenamePresetCommand}" Margin="0,0,6,6"/>
                    <Button Content="Delete preset" Command="{Binding DeletePresetCommand}" Margin="0,0,0,6"/>
                  </WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" DragCompleted="PanelDragCompleted" AutomationProperties.Name="Resize sources panel"/>
      <Border Grid.Column="2" Style="{StaticResource DockSurface}" Padding="8" DataContext="{Binding Screen}">
        <Grid x:Name="StudioPreview">
          <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Fit" Command="{Binding FitPreviewCommand}"/>
              <Button Content="1:1" Command="{Binding ActualPreviewSizeCommand}" Margin="6,0" ToolTip="Actual source pixels; scroll to inspect"/>
              <Grid>
                <Button Content="Start preview" Command="{Binding StartStudioPreviewCommand}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCameraPreviewing}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="Stop preview" Command="{Binding StopStudioPreviewCommand}" Visibility="{Binding IsCameraPreviewing, Converter={StaticResource BoolVisibility}}"/>
              </Grid>
            </StackPanel>
            <TextBlock Text="{Binding StudioPreviewState}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Grid.Row="1" Background="{StaticResource CanvasBrush}" CornerRadius="8" ClipToBounds="True">
            <Grid>
              <ScrollViewer>
                <ScrollViewer.Style>
                  <Style TargetType="ScrollViewer">
                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PreviewActualSize}" Value="True">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollViewer.Style>
                <Grid Width="{Binding StudioPreviewWidth}" Height="{Binding StudioPreviewHeight}">
                  <Image Source="{Binding CameraPreview}" Stretch="Uniform" AutomationProperties.Name="Selected capture source preview"/>
                  <views:CompositePreviewEditor Visibility="{Binding IsCombined, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
              </ScrollViewer>
              <StackPanel Visibility="{Binding HasNoPreview, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <TextBlock Text="Your next take starts here" FontSize="22" TextAlignment="Center"/>
                <TextBlock Text="Choose a source and start preview when you’re ready." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeDirection="Columns" DragCompleted="PanelDragCompleted" AutomationProperties.Name="Resize properties panel"/>
      <Border x:Name="PropertiesDock" Grid.Column="4" Style="{StaticResource DockSurface}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="SOURCE INSPECTOR" Style="{StaticResource DockTitle}"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="{Binding Screen.SelectedStudioSource.Name}" Foreground="{StaticResource CyanBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Screen.SelectedStudioSource.Name}" Margin="0,0,0,8"/>
              <Expander Header="Capture configuration" IsExpanded="True">
                <views:RecordingPreferences DataContext="{Binding Screen}"/>
              </Expander>
              <Expander IsExpanded="{Binding Screen.IsSelectedCameraSource, Mode=OneWay}" Header="Camera and picture-in-picture" Visibility="{Binding Screen.IsCameraMode, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                <views:CameraControls ShowPreview="False" DataContext="{Binding Screen}"/>
              </Expander>
              <Expander Header="Audio source properties" IsExpanded="{Binding Screen.IsSelectedAudioSource, Mode=OneWay}" Visibility="{Binding Screen.IsSelectedAudioSource, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                <views:AudioPreferences DataContext="{Binding Screen}"/>
              </Expander>
              <Expander Header="Quality, encoder and cursor effects" Margin="0,12,0,0">
                <views:VideoPreferences DataContext="{Binding Screen}"/>
              </Expander>
              <Expander Header="Output folder" Margin="0,12,0,0">
                <views:StoragePreferences/>
              </Expander>
              <TextBlock Text="Source, format and quality settings are locked during recording. Gain, mute and PIP geometry use the existing live pipeline." Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" DragCompleted="PanelDragCompleted" AutomationProperties.Name="Resize mixer and controls"/>
    <Border x:Name="MixerDock" Grid.Row="3" Style="{StaticResource DockSurface}" Padding="12,8">
      <views:StudioAudioMixer DataContext="{Binding Screen}"/>
    </Border>
    <Border Grid.Row="4" Background="{StaticResource CanvasBrush}" Padding="8,6">
      <views:StudioRecordingControls DataContext="{Binding Screen}"/>
    </Border>
    <DockPanel Grid.Row="5">
      <TextBlock DockPanel.Dock="Right" Text="{Binding Screen.StatusMessage}" ToolTip="{Binding Screen.CaptureExclusionNotice}" MaxWidth="480" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
      <TextBlock Text="{Binding Screen.StudioMessage}" ToolTip="{Binding Screen.StudioConfigurationSummary}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</UserControl>
